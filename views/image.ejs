<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gemini AI Image Analyzer</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="container">
      <h1>🖼️ Gemini AI Image Analyzer</h1>

      <div class="card">
        <div class="image-section">
          <img src="/code.jpg" alt="Analyzed Image" class="image" />
        </div>

        <div class="text-section">
          <h2>🧠 AI Analysis</h2>
          <p class="response"><%= data %></p>
        </div>
      </div>

      <footer>Powered by <b>Gemini API</b> ⚡</footer>
    </div>
  </body>
</html>
